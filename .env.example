# ===============================================================
# PRAMAAN / PARMAAN ENVIRONMENT CONFIGURATION
# ===============================================================

# 1. Server Configuration
PORT=10000
FLASK_ENV=production
PYTHONUNBUFFERED=1

# 2. Firebase Project ID
FIREBASE_PROJECT_ID=pramaan-1

# 3. Firebase Admin SDK Credentials
# OPTION A (For Render / Cloud): Paste the raw JSON string of your service account key here
FIREBASE_ADMIN_CREDENTIALS={"type":"service_account","project_id":"pramaan-1",...}

# OPTION B (For Local Development): Path to your local service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./pramaan-1-firebase-adminsdk-fbsvc-4cc3aede82.json
